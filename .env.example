# Copy to .env and fill in. Never commit .env.

# Qdrant (vector store) — Cloud or self-hosted-in-Docker.
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=resume_chunks

# Notion (tracking store) — internal integration token, shared with your
# job-tracking database. See docs/adr/0003-tracking-store-default-notion.md.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Path to your tracking field schema — copy tracking_schema.example.yaml
# to tracking_schema.yaml (or anywhere on disk) and point this at it.
# Defaults to ./tracking_schema.yaml if unset. See
# docs/adr/0011-configurable-tracking-field-schema.md.
TRACKING_SCHEMA_PATH=

# Path to your candidate profile (comp floor, title-mapping calibration)
# — copy candidate_profile.example.yaml to candidate_profile.yaml (or
# anywhere on disk) and point this at it. Defaults to
# ./candidate_profile.yaml if unset. See
# docs/adr/0012-comp-floor-and-title-mapping-calibration.md.
CANDIDATE_PROFILE_PATH=
