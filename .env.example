# Copy to .env and fill in. Never commit .env.

# Qdrant (vector store) — Cloud or self-hosted-in-Docker.
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=resume_chunks

# Notion (tracking store) — internal integration token, shared with your
# job-tracking database. See docs/adr/0003-tracking-store-default-notion.md.
NOTION_API_KEY=
NOTION_DATABASE_ID=
